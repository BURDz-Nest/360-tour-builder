# Dependencies / build artifacts
node_modules/
dist/
.cache/

# Python (if ever added)
.venv/
venv/
__pycache__/
*.pyc

# Env / secrets — NEVER commit SAS tokens or connection strings
.env
.env.*
*.secret
azure-credentials*

# OS noise
.DS_Store
Thumbs.db

