# Dependencies / build artifacts
node_modules/
dist/
.cache/

# Python (if ever added)
.venv/
venv/
__pycache__/
*.pyc

# Env / secrets — NEVER commit SAS tokens or connection strings
.env
.env.*
*.secret
azure-credentials*

# OS noise
.DS_Store
Thumbs.db

# Raw full-resolution source photos (dev-only staging area). These are large;
# the web-optimized copies that ship live inside each tours/<name>/images/.
source-photos/

# Editor
.vscode/
.idea/

# Local working tours that may contain sensitive image URLs.
# Keep examples/ tracked; ignore a personal scratch folder.
/local-tours/
*.local.json

# Tours are local working data — often real-facility imagery that should NOT
# live in the public repo. Keep the folder present (via .gitkeep) but ignore
# all tour contents. Author tours locally; publish each tours/<name>/ folder
# to ITS OWN hosting target, not to this repo.
/tours/*
!/tours/.gitkeep
